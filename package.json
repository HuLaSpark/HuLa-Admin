{
  "name": "vue3-ts",
  "private": true,
  "version": "v1.0.5-alpha",
  "engines": {
    "node": "16.x || 18.x || 20.x"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint src"
    ]
  },
  "scripts": {
    "dev": "vite --mode dev",
    "pro": "vite --mode pro",
    "build:dev": "vite build --mode dev",
    "build:pro": "vite build --mode pro",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "fix": "eslint --ext .js,.jsx,.ts,.vue src --fix",
    "commitlint": "commitlint --config commitlint.config.js -e -V",
    "preinstall": "npx only-allow pnpm",
    "prepare": "npx husky install",
    "commit": "git add . && lint-staged && git-cz && conventional-changelog -p cz-config.js -i CHANGELOG.md -s -r 0",
    "changelog": "conventional-changelog -p cz-config.js -i CHANGELOG.md -s -r 0",
    "lint:staged": "lint-staged"
  },
  "dependencies": {
    "@animxyz/core": "^0.6.6",
    "@animxyz/vue3": "^0.6.7",
    "@intlify/unplugin-vue-i18n": "^0.11.0",
    "@vicons/tabler": "^0.12.0",
    "@vueuse/core": "^10.4.1",
    "animate.css": "^4.1.1",
    "axios": "^1.4.0",
    "dayjs": "^1.11.10",
    "echarts": "5.4.1",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "naive-ui": "^2.34.4",
    "notiflix": "^3.2.6",
    "pinia": "^2.1.4",
    "pinia-plugin-persistedstate": "^3.1.0",
    "screenfull": "^6.0.2",
    "vue": "^3.3.4",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.2",
    "vue3-count-to": "^1.1.2",
    "xterm": "^5.2.1",
    "xterm-addon-fit": "^0.7.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.5",
    "@commitlint/cli": "^17.6.6",
    "@commitlint/config-conventional": "^17.6.6",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "^20.3.2",
    "@typescript-eslint/eslint-plugin": "^5.60.0",
    "@typescript-eslint/parser": "^5.60.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vitest/ui": "^0.32.2",
    "@vue/test-utils": "^2.4.0",
    "commitizen": "^4.3.0",
    "commitlint-config-cz": "^0.13.3",
    "conventional-changelog": "^4.0.0",
    "conventional-changelog-cli": "^3.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.0.0",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.15.1",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "only-allow": "^1.2.0",
    "prettier": "^2.8.8",
    "sass": "^1.63.6",
    "sass-loader": "^13.3.2",
    "stylelint": "^15.10.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^4.2.0",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-recommended-scss": "^12.0.0",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-prettier": "^3.0.0",
    "stylelint-scss": "^5.0.1",
    "tsx": "^3.12.10",
    "typescript": "5.2.2",
    "unplugin-auto-import": "^0.16.4",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^4.4.9",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^0.4.10",
    "vitest": "^0.32.2",
    "vue-tsc": "^1.8.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}
